# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (Optional - falls back to local JSON file in server/data/leads.json if absent)
MONGODB_URI=

# Email Configuration (Nodemailer - optional, will mock/log to console if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=leads@leadsgrow.com

